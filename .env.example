# Copy this file to .env. Values already set in the shell take precedence.
ANALYZER_AUTO_INSTALL=true
ANALYZER_AI_ENABLED=true
ANALYZER_AI_PROVIDER=9router
NINEROUTER_URL=http://localhost:20128
NINEROUTER_MODEL=GoRouter/claude-opus-5-thinking
NINEROUTER_KEY=
# Optional extra scanner/tool directories, separated by ; on Windows.
# ANALYZER_TOOL_PATHS=C:\Tools\bin;C:\OtherTools\bin

# Alternative direct Anthropic configuration:
# ANALYZER_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
